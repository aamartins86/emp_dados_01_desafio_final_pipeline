# Copie este arquivo para .env e substitua os valores locais.
# Nunca coloque credenciais reais neste arquivo de exemplo.

# Conexão com o banco de dados
DB_DRIVER=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_emp_dados_junior
DB_SCHEMA=bronze
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# Diretório da camada Bronze
DATA_BRONZE_PATH=arquivos_locais/data/bronze

# Logs
LOG_LEVEL=INFO
LOG_DIR=arquivos_locais/logs

# Requisições ao Banco Central (uma tentativa por indicador)
HTTP_TIMEOUT_SECONDS=30
